# 开发库（宿主机端口 15432，容器内 5432）
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:15432/ecommerce?schema=public"

# 测试库（e2e 用，与开发库物理隔离）
DATABASE_URL_TEST="postgresql://ecommerce:ecommerce@localhost:15432/ecommerce_test?schema=public"

# 应用
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET="change-me-in-production-at-least-32-chars-long"
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_TTL_DAYS=30

# 收款账户与出款单快照的字段加密密钥（≥ 32 字符）。
# ⚠️ 生产环境禁止用这个占位符；轮换后已打款的快照将永久解不开。
# ⚠️ 必须与 JWT_SECRET 的占位符**不同值**：两个校验都是等值比较，
#    相同的话将来把 JWT_SECRET 换成真实值时，账目密钥的占位符检查就失去意义。
PAYOUT_ACCOUNT_ENCRYPTION_KEY="change-me-in-production-payout-key-at-least-32-chars-long"

# MinIO（媒体上传）。宿主机端口 19000，容器内 9000。
#
# ⚠️ MINIO_ENDPOINT 必须是**带协议头的完整 URL**：Task 6 会用它拼媒体访问地址
# 与 presigned URL 的 host，少了 http:// 会拼出「19000/ecommerce-media/xxx」
# 这种浏览器打不开的地址。
#
# 浏览器直传用的是宿主机端口，不是容器内端口——容器内的 api 签发
# presigned URL 时也必须用这个对外地址，否则浏览器解析不了 minio:9000。
MINIO_ENDPOINT=http://localhost:19000
# 后端自己访问 MinIO 用的地址（HEAD 确认、删除孤儿）。
#
# ⚠️ 这份 .env 是**本机开发**用的（npm run start:dev 会读它），
# 所以这里必须是 localhost。`minio:9000` 只在 compose 的容器网络里解析得了，
# 填进去的症状很隐蔽：上传成功但 confirm 失败、孤儿清理静默不工作。
# compose 里的 api 服务会用 infra/.env 覆盖成 http://minio:9000，两者互不影响。
MINIO_INTERNAL_ENDPOINT=http://localhost:19000
# 媒体对外访问的基地址。生产部署时这里应该是 CDN 或 Nginx 暴露的域名，
# 与 MINIO_ENDPOINT 可能不同——所以单独拆一个变量。
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_BUCKET=ecommerce-media
# bucket 不会自动创建——镜像里没有 mc，Task 6 用 @aws-sdk/client-s3 的
# CreateBucketCommand 建（那时依赖已经装好）
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=ecommerce
MINIO_SECRET_KEY=ecommerce-minio-secret
# 单文件大小上限（字节）
MEDIA_MAX_SIZE=5242880
# 孤儿清理定时器的间隔（毫秒），默认 1 小时
MEDIA_CLEANUP_INTERVAL_MS=3600000

# Redis（BullMQ 队列）。宿主机端口 16380：本机标准端口 6379 已被其他项目栈占用。
# 容器内的 api 服务由 compose 覆盖成带密码的服务名地址。
# ⚠️ 密码必须与 infra/.env 的 REDIS_PASSWORD 一致（阶段 7a 起 redis 开了 requirepass），
#    两边只维护 infra/.env 一处。
REDIS_URL=redis://:ecommerceRedis163@localhost:16380

# ---- 本地假支付网关（仅本机开发）----
#
# ⚠️ **默认关闭**（不设就是关）。假网关的支付页面**无需登录**——
# 知道 paymentId 就能把订单付掉，所以它是**安全边界**，不是便利开关。
#
# ⚠️ **生产环境开启会拒绝启动**（见 common/config/assert-secure-config.ts）：
# NODE_ENV=production 且 FAKE_PAYMENT_ENABLED=true → 进程硬失败。
#
# FAKE_PAYMENT_ENABLED=true
#
# 假网关回调的共享密钥。webhook 端点用它做「验签」——
# 密钥不对直接 401，**一个字都不写进数据库**。
# 留空等于没有验签（代码会拒绝签空的请求，但别指望它兜底）。
#
# FAKE_PAYMENT_SECRET=change-me-fake-payment-secret-at-least-16-chars

# ---- 本地假出款网关（仅本机开发）----
#
# ⚠️ **默认关闭**（不设就是关）。它能让「打款失败」→ 商家会以为平台不给钱，
# 所以它同样是**安全边界**，不是便利开关。
#
# ⚠️ **独立于 FAKE_PAYMENT_ENABLED**：用同一个开关的话，
# 开着假支付就等于同时开着假出款，两个环境的启停会互相牵连。
#
# ⚠️ **生产环境开启会拒绝启动**（见 common/config/assert-secure-config.ts）：
# NODE_ENV=production 且 FAKE_PAYOUT_ENABLED=true → 进程硬失败。
#
# FAKE_PAYOUT_ENABLED=true

# ---- 支付 / 出款渠道（阶段 6a）----
#
# 哪些渠道被启用**只由这里决定**，注册表与启动校验读同一份解析
# （common/channel/channel-config.ts），不会出现「启动放行、运行时取不到」。
#
# ⚠️ 不设时：非生产环境默认启用 fake / fake-payout；
#    **生产环境不会默认启用任何渠道**（fail-closed），必须显式设置。
# ⚠️ 生产环境启用 fake / fake-payout / sandbox，或把 CHANNEL_MODE 设成 sandbox，
#    都会**拒绝启动**（见 common/config/assert-secure-config.ts）。
#
# PAYMENT_ENABLED_CHANNELS=fake
# PAYOUT_ENABLED_CHANNELS=fake-payout
#
# 平台默认出款渠道的**兜底值**：仅当平台后台（platform_settings）没配时使用。
# 若设置，必须在 PAYOUT_ENABLED_CHANNELS 的启用列表内，否则拒绝启动；
# 生产环境允许不设。
# PAYOUT_PLATFORM_DEFAULT_CHANNEL=fake-payout
#
# 沙箱模式（阶段 6b 引入 sandbox 渠道后才有意义）。当前允许值只有 sandbox，
# 填其他非空值会拒绝启动；生产环境设置 CHANNEL_MODE=sandbox 同样拒绝启动。
# CHANNEL_MODE=sandbox

# 启动校验的「已部署实现」名单目前登记为
# PAYMENT: fake / sandbox、PAYOUT: fake-payout / sandbox。启用未登记的渠道会拒绝启动。
# ⚠️ sandbox 同时在「仅限非生产」名单里：生产环境启用仍会拒绝启动。

# ---- 沙箱渠道（阶段 6b，仅非生产）----
#
# sandbox 渠道**走真实 HTTP**：地址指向 test/mock-channel-server.ts 起的 mock 服务
# （或本地另一个 mock）。**不设置时 sandbox 不会注册**，避免「配了渠道却没地址」
# 在运行期第一笔调用才炸。
#
# 测试里服务监听 0 端口，地址每次不同，所以这里留注释而不是给默认值。
# SANDBOX_CHANNEL_URL=http://127.0.0.1:3999
#
# 出款异步开关：true 时 mock 服务的 submit 先返回 PROCESSING，之后 queryPayout 转终态。
# 只影响 mock 行为；沙箱 provider 的 asyncPayout 能力声明恒为 true。
# SANDBOX_PAYOUT_ASYNC=true
#
# 失败注入场景：success / reject / timeout / amount_mismatch / processing。
# reject → FAILED + definitive=true；timeout → 客户端超时抛异常（结果未知）；
# amount_mismatch → 返回金额与请求不同；processing → 先 PROCESSING 再转 SUCCESS。
# SANDBOX_SCENARIO=success
#
# 退款剧本（阶段 6c）：success / processing / reject / unknown。
# processing → 先 PROCESSING、之后 queryRefund 转 SUCCESS；
# reject → FAILED + definitive=true（可安全重试）；
# unknown → FAILED + definitive=false（结果未知，绝不可自动重试）。
# SANDBOX_REFUND_SCENARIO=success
#
# 退款异步开关：true 时 success 剧本也先返回 PROCESSING，之后由查询给出终态。
# SANDBOX_REFUND_ASYNC=true
#
# 回调验签共享密钥（HMAC-SHA256 签原始 body，请求头 x-sandbox-signature）。
# 不设密钥时 parseWebhook 直接拒绝（不会退化成「不验签」）。
# SANDBOX_PAYMENT_SECRET=change-me-sandbox-payment-secret-32-chars

# ---- 可观测性（阶段 11）----
# 日志级别（pino）：trace / debug / info / warn / error。默认 info；jest 下默认 warn。
# LOG_LEVEL=info
# true 时本地开发输出 pino-pretty 人读格式；默认 JSON（生产必须 JSON）。
# 未显式设置时：非生产 + TTY + 非 jest 进程会自动开。
# LOG_PRETTY=false
# 渠道告警的 webhook 地址（飞书 / 钉钉 / 自建值班群的机器人）。
# 不配时告警退回打日志（LoggingChannelAlertSink）。URL 含机器人密钥，不要提交到仓库。
# ALERT_WEBHOOK_URL=
# 告警 payload 格式：generic（默认，裸 JSON）/ feishu / dingtalk。
# ALERT_WEBHOOK_FORMAT=generic
# 同一告警（channel+operation+referenceNo）的去重窗口（毫秒），默认 10 分钟。
# ALERT_DEDUP_WINDOW_MS=600000
# 全局告警限频：每分钟最多发送条数，超过丢弃并记日志，默认 10。
# ALERT_MAX_PER_MINUTE=10
