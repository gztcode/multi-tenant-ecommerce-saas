# 开发库（宿主机端口 15432，容器内 5432）
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:15432/ecommerce?schema=public"

# 测试库（e2e 用，与开发库物理隔离）
DATABASE_URL_TEST="postgresql://ecommerce:ecommerce@localhost:15432/ecommerce_test?schema=public"

# 应用
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET="change-me-in-production-at-least-32-chars-long"
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_TTL_DAYS=30

# 收款账户与出款单快照的字段加密密钥（≥ 32 字符）。
# ⚠️ 生产环境禁止用这个占位符；轮换后已打款的快照将永久解不开。
# ⚠️ 必须与 JWT_SECRET 的占位符**不同值**：两个校验都是等值比较，
#    相同的话将来把 JWT_SECRET 换成真实值时，账目密钥的占位符检查就失去意义。
PAYOUT_ACCOUNT_ENCRYPTION_KEY="change-me-in-production-payout-key-at-least-32-chars-long"

# MinIO（媒体上传）。宿主机端口 19000，容器内 9000。
#
# ⚠️ MINIO_ENDPOINT 必须是**带协议头的完整 URL**：Task 6 会用它拼媒体访问地址
# 与 presigned URL 的 host，少了 http:// 会拼出「19000/ecommerce-media/xxx」
# 这种浏览器打不开的地址。
#
# 浏览器直传用的是宿主机端口，不是容器内端口——容器内的 api 签发
# presigned URL 时也必须用这个对外地址，否则浏览器解析不了 minio:9000。
MINIO_ENDPOINT=http://localhost:19000
# 后端自己访问 MinIO 用的地址（HEAD 确认、删除孤儿）。
#
# ⚠️ 这份 .env 是**本机开发**用的（npm run start:dev 会读它），
# 所以这里必须是 localhost。`minio:9000` 只在 compose 的容器网络里解析得了，
# 填进去的症状很隐蔽：上传成功但 confirm 失败、孤儿清理静默不工作。
# compose 里的 api 服务会用 infra/.env 覆盖成 http://minio:9000，两者互不影响。
MINIO_INTERNAL_ENDPOINT=http://localhost:19000
# 媒体对外访问的基地址。生产部署时这里应该是 CDN 或 Nginx 暴露的域名，
# 与 MINIO_ENDPOINT 可能不同——所以单独拆一个变量。
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_BUCKET=ecommerce-media
# bucket 不会自动创建——镜像里没有 mc，Task 6 用 @aws-sdk/client-s3 的
# CreateBucketCommand 建（那时依赖已经装好）
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=ecommerce
MINIO_SECRET_KEY=ecommerce-minio-secret
# 单文件大小上限（字节）
MEDIA_MAX_SIZE=5242880
# 孤儿清理定时器的间隔（毫秒），默认 1 小时
MEDIA_CLEANUP_INTERVAL_MS=3600000

# Redis（BullMQ 队列）。宿主机端口 16380：本机标准端口 6379 已被其他项目栈占用。
# 容器内的 api 服务由 compose 覆盖成 redis://redis:6379。
REDIS_URL=redis://localhost:16380

# ---- 本地假支付网关（仅本机开发）----
#
# ⚠️ **默认关闭**（不设就是关）。假网关的支付页面**无需登录**——
# 知道 paymentId 就能把订单付掉，所以它是**安全边界**，不是便利开关。
#
# ⚠️ **生产环境开启会拒绝启动**（见 common/config/assert-secure-config.ts）：
# NODE_ENV=production 且 FAKE_PAYMENT_ENABLED=true → 进程硬失败。
#
# FAKE_PAYMENT_ENABLED=true
#
# 假网关回调的共享密钥。webhook 端点用它做「验签」——
# 密钥不对直接 401，**一个字都不写进数据库**。
# 留空等于没有验签（代码会拒绝签空的请求，但别指望它兜底）。
#
# FAKE_PAYMENT_SECRET=change-me-fake-payment-secret-at-least-16-chars

# ---- 本地假出款网关（仅本机开发）----
#
# ⚠️ **默认关闭**（不设就是关）。它能让「打款失败」→ 商家会以为平台不给钱，
# 所以它同样是**安全边界**，不是便利开关。
#
# ⚠️ **独立于 FAKE_PAYMENT_ENABLED**：用同一个开关的话，
# 开着假支付就等于同时开着假出款，两个环境的启停会互相牵连。
#
# ⚠️ **生产环境开启会拒绝启动**（见 common/config/assert-secure-config.ts）：
# NODE_ENV=production 且 FAKE_PAYOUT_ENABLED=true → 进程硬失败。
#
# FAKE_PAYOUT_ENABLED=true
