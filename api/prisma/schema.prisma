generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
  CUSTOMER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  DRAFT
  LIVE
  PAUSED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  subdomain String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users  User[]
  stores Store[]

  // ---------- 商品中心（Task 2）反向关系 ----------
  // Prisma 要求双向关系都声明，否则 schema 校验直接失败。
  categories         Category[]
  products           Product[]
  productSpecs       ProductSpec[]
  productSpecValues  ProductSpecValue[]
  skus               Sku[]
  skuSpecValues      SkuSpecValue[]
  medias             Media[]
  productMedias      ProductMedia[]
  inventoryMovements InventoryMovement[]

  // ---------- 交易链路（计划 3）反向关系 ----------
  carts Cart[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String
  phone        String?
  passwordHash String
  displayName  String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // ---------- 交易链路（计划 3）反向关系 ----------
  // Cart 声明了 customer User? @relation，Prisma 要求双向都声明。
  carts Cart[]

  // 邮箱唯一性分三层，全部由原生 SQL 的**部分唯一索引**保证，Prisma schema
  // 表达不了条件唯一约束，因此这里刻意不再声明任何 @@unique：
  //   PLATFORM_ADMIN → users_platform_admin_email_key（全局，tenantId IS NULL）
  //   MERCHANT_OWNER → users_merchant_owner_email_key（全局，见 add_merchant_owner_email_unique）
  //   CUSTOMER / MERCHANT_STAFF → users_customer_email_ci_key（租户内，见 narrow_customer_email_ci_unique）
  //
  // ⚠️ 曾经的 @@unique([tenantId, email]) 已删除（见 drop_user_tenant_email_unique）。
  // 它不含角色，会把「店主在自己开的店里当消费者下单」这种正常用法也一起挡掉，
  // 抛出无法解释给用户的 P2002。留下它等于让部分索引形同虚设——
  // 它更严格，冲突永远发生在部分索引之前。
  //
  // db push 等同步路径下会缺失这些部分索引，届时邮箱唯一性会暂时失效；
  // 正式环境一律用 migrate deploy。
  //
  // 配合应用层统一小写化的 email 精确查询
  @@index([email])
  @@map("users")
}

enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  REPLAY
}

model RefreshToken {
  id            String                     @id @default(uuid())
  userId        String
  // ROTATED：刷新时轮换掉旧令牌
  // LOGOUT：用户主动登出
  // REPLAY：疑似泄露，令牌族整体作废
  // 重放检测只对 ROTATED 触发——登出后的令牌被再次使用不牵连其它设备。
  revokedReason RefreshTokenRevokedReason?
  tokenHash     String                     @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  // ⚠️ 阶段 5c：宽限期记录。
  //
  // rotatedToToken 存的是本枚令牌轮换出的**新令牌的密文**（AES-256-GCM），
  // 不是明文 —— 沿用 token.util.ts 里「不存明文」的原则
  // （这张表经常被备份与只读分析）。
  // graceExpiresAt 是宽限截止时刻，轮换时一次定死，不因重放而延长。
  rotatedToToken String?
  graceExpiresAt DateTime?
  createdAt     DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Store {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  slug          String
  status        StoreStatus @default(DRAFT)
  themeTokens   Json        @default("{}")
  paymentConfig Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 复合唯一索引的最左前缀已能服务「按 tenantId 查该租户的店铺」，
  // 不需要再单独建 @@index([tenantId])
  @@unique([tenantId, slug])
  @@map("stores")
}

// ---------- 商品中心 ----------

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  sort      Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  // ⚠️ 唯一索引刻意**不在 schema 里声明**：软删除后 slug 仍占用唯一性，
  // 而普通的 @@unique 做不到「仅对未删除记录生效」——带 deletedAt 的复合唯一
  // 也无效，因为 PostgreSQL 的 NULL 不参与唯一性判定。
  // 改由迁移手写部分唯一索引（见 migration.sql）。
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  categoryId  String?
  name        String
  slug        String
  subtitle    String?
  description String?
  status      ProductStatus @default(DRAFT)
  attributes  Json          @default("{}")
  minPrice    Int           @default(0)
  version     Int           @default(1)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specs    ProductSpec[]
  skus     Sku[]
  media    ProductMedia[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model ProductSpec {
  id        String    @id @default(uuid())
  tenantId  String
  productId String
  name      String
  sort      Int       @default(0)
  deletedAt DateTime?

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductSpecValue[]
  // Cascade：删租户（销户 / 违规清退）必须连带清掉全部业务数据，
  // 若这里默认成 Restrict，删租户会被自己的关联表挡住而失败。
  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ⚠️ 唯一索引刻意**不在 schema 里声明**，由迁移手写部分唯一索引（见迁移文件）。
  // 软删除后同名规格会占用普通 @@unique：商家把「颜色」规格删掉再加一个同名
  // 的，数据库会直接拒绝。
  @@index([tenantId, productId])
  @@map("product_specs")
}

model ProductSpecValue {
  id        String    @id @default(uuid())
  tenantId  String
  specId    String
  value     String
  mediaId   String?
  sort      Int       @default(0)
  deletedAt DateTime?

  spec          ProductSpec    @relation(fields: [specId], references: [id], onDelete: Cascade)
  media         Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skuSpecValues SkuSpecValue[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引（软删除后同名值不占用唯一性）。
  @@index([tenantId, specId])
  @@map("product_spec_values")
}

enum SkuStatus {
  ACTIVE
  INACTIVE
}

model Sku {
  id           String    @id @default(uuid())
  tenantId     String
  productId    String
  code         String?
  price        Int
  comparePrice Int?
  stock        Int       @default(0)
  // 库存的乐观锁版本号。库存调整是「读库存 → 算 delta → 写」，
  // 并发时两个请求会各自读到同一个旧值、后写的覆盖先写的（丢失更新）——
  // 症状是入库两笔却只进了一笔。把版本号放进 updateMany 的 where，
  // 由数据库在写入那一刻判定，受影响行数为 0 即说明期间有人改过。
  // 与 Product.version 是同一个模式。
  stockVersion Int       @default(0)
  status       SkuStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  specValues SkuSpecValue[]
  movements  InventoryMovement[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ---------- 交易链路（计划 3）反向关系 ----------
  // CartItem 声明了 sku Sku @relation，Prisma 要求双向都声明。
  cartItems CartItem[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, productId])
  @@map("skus")
}

model SkuSpecValue {
  id       String @id @default(uuid())
  tenantId String
  skuId    String
  valueId  String

  sku    Sku              @relation(fields: [skuId], references: [id], onDelete: Cascade)
  value  ProductSpecValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([skuId, valueId])
  @@index([tenantId, skuId])
  @@map("sku_spec_values")
}

enum MediaStatus {
  PENDING
  READY
  ORPHANED
}

model Media {
  id         String      @id @default(uuid())
  tenantId   String
  key        String
  url        String
  mime       String
  size       Int
  width      Int?
  height     Int?
  status     MediaStatus @default(PENDING)
  uploadedBy String
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products   ProductMedia[]
  specValues ProductSpecValue[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, status])
  @@map("media")
}

model ProductMedia {
  id        String @id @default(uuid())
  tenantId  String
  productId String
  mediaId   String
  sort      Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([tenantId, productId])
  @@map("product_medias")
}

enum InventoryMovementType {
  INITIAL
  ADJUST_IN
  ADJUST_OUT
  CHECK
  RESERVE
  RELEASE
  DEDUCT
}

model InventoryMovement {
  id          String                @id @default(uuid())
  tenantId    String
  skuId       String
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  // 谁做了这次库存变动。
  //
  // ⚠️ 可空：阶段 2 的库存调整是商家手动操作，填店主 id；
  // 阶段 3 的预占（RESERVE）/释放（RELEASE）是**系统行为**，没有人工操作人——
  // 游客下单时连 orders.customerId 都是空的，填不出一个消费者 id。
  // 填 'system' 这类假值会让「谁动了库存」失真，所以宁可留空。
  operatorId  String?
  createdAt   DateTime              @default(now())
  // 这次库存变动属于哪个订单（订单的 uuid，不是 orderNo）。
  //
  // ⚠️ **流水与订单之间原本只有自由文本的 reason**（形如「订单 <uuid> 预占」），
  // 没有任何数据层关联——要查「某个订单预占了多少」只能去解析 reason 文本。
  // 于是「这些条目确实被预占过」这件事无法在数据层验证：
  // 对一个从未预占过的 SKU 调释放，库存会凭空 +5，而流水与库存的净变化
  // **是自洽的**，对账时看不出问题。
  //
  // 有了这个字段就能按 orderId 汇总出「尚未被冲抵的预占量」，
  // 释放与扣减都拿它当上限校验——把「释放的正确性」从
  // 「调用方记得先判赢家」变成数据层保证。
  //
  // ⚠️ 可空：阶段 2 的 INITIAL / ADJUST_IN / ADJUST_OUT 流水与订单无关。
  orderId String?

  // Restrict 而非 Cascade：流水是审计凭证，物理删除有流水的 SKU 必须被数据库拒绝
  sku    Sku    @relation(fields: [skuId], references: [id], onDelete: Restrict)
  // 对租户同样保持 Restrict（默认值）：流水是合规凭证，销户时不允许被级联抹掉。
  // 代价是「有流水的租户」无法直接物理删除——这是刻意的，
  // 销户流程应走软删（Tenant 自身状态）而非 DELETE。
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, skuId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ---------- 交易链路（计划 3） ----------

model Cart {
  id         String   @id @default(uuid())
  tenantId   String
  // 登录用户的购物车：customerId 有值、guestToken 为空
  customerId String?
  // 游客的购物车：guestToken 有值、customerId 为空
  guestToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer User?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  // ⚠️ 唯一索引刻意**不在 schema 里声明**：一个消费者在同一店铺只有一个购物车
  // 是「登录合并」的前提，靠部分唯一索引保证（Prisma 表达不了条件唯一约束）。
  // 见 add_transaction_tables 迁移里手写的两个部分唯一索引。
  @@index([tenantId, customerId])
  @@index([tenantId, guestToken])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  tenantId  String
  cartId    String
  skuId     String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@index([tenantId, cartId])
  @@map("cart_items")
}

model Address {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  receiver   String
  phone      String
  province   String
  city       String
  district   String
  detail     String
  isDefault  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 加上外键的话「跨租户挂载」会被数据库悄悄放行（外键只引用 id 不带 tenantId），
  // 由 service 层显式校验归属（设计 §3.3）。
  //
  // ⚠️ 默认地址唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, customerId])
  @@map("addresses")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
  CLOSED
}

model Order {
  id         String      @id @default(uuid())
  tenantId   String
  orderNo    String      @unique
  customerId String?
  status     OrderStatus @default(PENDING_PAYMENT)

  totalAmount Int
  itemCount   Int

  // 收货信息快照（来自下单时选中的地址，之后地址簿改了也不影响订单）
  receiverName  String
  receiverPhone String
  province      String
  city          String
  district      String
  detail        String

  remark String?

  // 幂等键。同一个键重复下单返回同一个订单，而不是新建一个。
  // 部分唯一索引：不同租户可以用同一个键（虽然不该，但不该因此报错）。
  idempotencyKey String?

  payChannel   String?
  payExpiresAt DateTime?
  paidAt       DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  closedAt     DateTime?
  trackingNo   String?

  // ---------- 阶段 5a：优惠快照 ----------
  //
  // ⚠️ **全部是快照**：券的名称、码、活动将来改了或删了，
  // 历史订单的金额与凭证都不受影响（设计文档 §7.2 M12）。
  //
  // ⚠️ `originalAmount` 是「优惠前的原价小计」，
  // `totalAmount` 是「优惠后的实付」——
  // **totalAmount 保持它现有的语义**（阶段 3 的支付金额核对读的是它，
  // 见 payment.service.ts 的 checkWebhookEvent：`event.amount !== order.totalAmount`），
  // 所以支付金额自动就是实付额，不需要改支付链路。
  originalAmount Int @default(0)
  // 满减活动减免
  promotionDiscountAmount Int @default(0)
  promotionId String?
  // 优惠券减免
  couponDiscountAmount Int @default(0)
  couponId String?
  couponCode String?
  couponName String?

  // ---------- 阶段 5b：抽佣与退款快照 ----------
  //
  // ⚠️ 同样是快照：抽佣费率将来随套餐调整，历史订单的抽佣额不能跟着变。
  /** 抽佣费率快照（基点）。下单时从套餐读，写死在订单上 */
  commissionRate Int @default(0)
  /** 抽佣额快照（整数分）。下单时按实付算出 */
  commissionAmount Int @default(0)
  /**
   * 退款时间。
   *
   * ⚠️ **阶段 3 的退款没有记时间** —— 报表的「退款冲回」要按**退款发生的
   * 期间**归期（不是按订单支付期间），所以这个字段是必需的。
   * 退款路径（`api/src/modules/payment/payment.service.ts` 的退款方法）
   * 要顺手写上 —— 但**那是下一个 Task 的事**。
   */
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 「跨租户挂载」由 service 层显式校验，而不是靠外键悄悄放行。
  items    OrderItem[]
  payments Payment[]

  // ⚠️ 幂等键的部分唯一索引由迁移手写，不在 schema 里声明。
  @@index([tenantId, customerId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid())
  tenantId    String
  orderId     String
  skuId       String
  productId   String
  // 下单时的商品名与规格快照。商家后来改了名、改了价，订单里必须是当时的
  productName String
  skuSnapshot Json
  quantity    Int
  unitPrice   Int
  subtotal    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  // 这笔支付单是订单支付还是订阅支付
  // ⚠️ `kind` 与 `orderId`/`invoiceId` 的一致性**目前没有 DB 层约束**
  // （`payments` 表上没有 CHECK），由应用层保证。
  kind          PaymentKind   @default(ORDER)
  /** 订单支付时填；订阅支付为 null */
  orderId       String?
  /** 订阅支付时填；订单支付为 null */
  invoiceId     String?
  channel       String
  // ⚠️ provider 与 channel **不是一回事**：channel 是「微信 / 支付宝 / 假网关」
  // 这类渠道名，provider 是「渠道背后的服务提供方」（微信支付 vs 微信服务商、
  // 支付宝 vs 支付宝服务商）。幂等去重要按 provider 走——同一笔交易在服务商
  // 模式下会同时收到「服务商」与「直连」两个渠道的通知。
  provider      String
  status        PaymentStatus @default(PENDING)
  providerTxnId String?
  amount        Int
  rawResponse   Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // ⚠️ 下面三条唯一索引**在 schema 里都不声明**，索引名只存在于迁移 SQL 中：
  // Prisma 的 @@unique 表达不了「NULL 不参与唯一判定」这个语义。
  //
  // 1. (provider, providerTxnId) → 迁移里的 `payments_provider_txn_uniq`。
  //    缺了它，同一笔渠道交易会落成两条支付单（设计 §3.6）。
  //
  // 2. (orderId, channel) → 迁移里的 `payments_order_channel_uniq`。
  //
  // 3. (invoiceId, channel) → 迁移里的 `payments_invoice_channel_uniq`。
  //
  // 第 2、3 条是**部分唯一索引**（WHERE ... IS NOT NULL）——
  // orderId / invoiceId 变可空后，PostgreSQL 的 NULL 不参与唯一判定，
  // 普通唯一索引会直接失效。
  //
  // ⚠️ 因此**不要**在这里补 `@@unique([orderId, channel])` 或
  // `@@unique([invoiceId, channel])`：写了也不生效
  // （schema 里补不出部分唯一索引），只会让人误以为约束已经在数据库层。
  @@index([tenantId, status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  eventId       String
  providerTxnId String?
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  // ⚠️ 这张表**不带 tenantId**，因此不在 TENANT_SCOPED_MODELS 白名单里
  // （它不是租户的数据，是渠道事件的数据）。租户从订单反查，不从事件里取。
  //
  // ⚠️ 唯一索引是「验签」之后的第二道防线，顺序不能反：
  // 先验签再落库，否则攻击者能抢先占住 (provider, eventId)，
  // 让真实回调被当成重复事件忽略——钱付了订单永不流转（设计 §3.7）。
  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

// ---------- 阶段 5a：营销（优惠券与满减活动） ----------

enum CouponType {
  FIXED
  PERCENT
}

enum CouponScope {
  SHOP
  PLATFORM
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model Coupon {
  id          String   @id @default(uuid())
  tenantId    String
  // 平台券的 tenantId 指向平台租户；店铺券指向商家租户
  code        String
  name        String
  description String?
  // FIXED：满减券（本阶段唯一实现的类型）
  // PERCENT：折扣券（预留，本阶段不实现）
  type        CouponType @default(FIXED)
  // FIXED 时是面额（整数分）；PERCENT 时是折扣数（85 = 85 折）
  value       Int
  // 使用门槛（整数分）。0 = 无门槛
  minAmount  Int      @default(0)
  // 每用户限领张数；null = 不限
  perUserLimit Int?
  // 总发放上限；null = 不限
  totalLimit  Int?
  // 已领取总数（用于限总量的并发判定）
  claimedCount Int    @default(0)
  // 已发放的券里，当前被订单预占核销的数量
  reservedCount Int    @default(0)
  // 已被订单实际使用的数量
  usedCount   Int      @default(0)
  // 平台券对所有店铺生效；店铺券只在本店生效
  scope       CouponScope @default(SHOP)
  status      CouponStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 与 Order / Address 同款做法：外键只引用 id 不带 tenantId，
  // 「跨租户挂载」由 service 层显式校验，而不是靠外键悄悄放行。
  //
  // ⚠️ 唯一索引由迁移手写部分唯一索引（软删后 code 仍占用唯一性）。
  @@index([tenantId, status])
  @@map("coupons")
}

model CouponClaim {
  id        String   @id @default(uuid())
  tenantId  String
  couponId  String
  customerId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  //
  // ⚠️ 唯一索引 (couponId, customerId) 由迁移手写，
  // 不在 schema 里声明（见 migration.sql）。
  @@index([tenantId, customerId])
  @@map("coupon_claims")
}

enum CouponRedemptionStatus {
  RESERVED
  USED
  RELEASED
}

model CouponRedemption {
  id         String   @id @default(uuid())
  tenantId   String
  couponId   String
  customerId String
  orderId    String
  // RESERVED：订单已创建，额度被占住；订单取消/超时后释放
  // USED：订单已支付，额度真正消耗
  // RELEASED：额度已退回
  status     CouponRedemptionStatus @default(RESERVED)
  // 下单时的优惠额快照
  discountAmount Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量（与 Order 同款）。
  //
  // ⚠️ 唯一索引由迁移手写部分唯一索引（见 migration.sql）。
  @@index([tenantId, customerId])
  @@map("coupon_redemptions")
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model Promotion {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  // 门槛（整数分）：订单商品原价小计 ≥ minAmount 才享受
  minAmount   Int      @default(0)
  // 减免金额（整数分）
  discountAmount Int
  status      PromotionStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  @@index([tenantId, status])
  @@map("promotions")
}

// ---------- 阶段 5b：平台计费（套餐、订阅、账单、支付方式） ----------

enum PlanStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  FAILED
}

enum PaymentKind {
  ORDER
  SUBSCRIPTION
}

model Plan {
  id          String    @id @default(uuid())
  code        String
  name        String
  description String?
  /** 周期价格（整数分）。0 = 免费 */
  price       Int
  /** 订阅周期（天）。30 = 按月 */
  periodDays  Int       @default(30)
  /** 试用期（天）。0 = 无试用 */
  trialDays   Int       @default(0)
  /** 抽佣比例（基点，万分之一）。500 = 5% */
  commissionBps Int     @default(0)
  /** 商品数上限。null = 不限 */
  maxProducts Int?
  /** SKU 数上限。null = 不限 */
  maxSkus     Int?
  /** 店铺数上限。null = 不限。默认 1（绝大多数套餐只允许一个店铺） */
  maxStores   Int?     @default(1)
  /** 功能开关。缺省一律视为 false（保守） */
  features    Json      @default("{}")
  status      PlanStatus @default(ACTIVE)
  /** 展示顺序（小的在前） */
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ⚠️ **这张表刻意不带 tenantId**：套餐是「平台的数据」而不是「租户的数据」
  //（先例是阶段 3 的 PaymentWebhookEvent）。所以它不在 TENANT_SCOPED_MODELS 里。
  @@unique([code])
  @@index([status, sortOrder])
  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String
  /** 套餐 id。⚠️ **纯标量，不声明 Prisma 关系** —— 套餐是平台的数据
   *  （不带 tenantId），订阅是租户的数据，
   *  跨域的外键会让「挂到一张不存在的套餐上」悄悄通过。
   *  与阶段 5a 的 `CouponClaim.couponId` 同款。 */
  planId       String
  /** 待生效的套餐（下个周期生效）。null = 不换 */
  pendingPlanId String?
  status       SubscriptionStatus @default(TRIAL)
  startedAt    DateTime           @default(now())
  /** 试用截止。null = 不是试用 */
  trialEndsAt  DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /** 到期后不自动续费 */
  cancelAtPeriodEnd  Boolean        @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  invoices Invoice[]

  @@unique([tenantId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String
  /** 套餐 id 快照（纯标量，同上） */
  planId         String
  /** 账单号（对外凭证，会出现在渠道页面与对账单里） */
  number         String
  /** 应付金额（整数分）。只从套餐价格读，不从请求体读 */
  amount         Int
  status         InvoiceStatus @default(OPEN)
  periodStart    DateTime
  periodEnd      DateTime
  /** 应付截止（一般是周期结束日） */
  dueAt          DateTime
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // ⚠️ 账单与订阅**同租户**，所以是真关系（不像 planId 那样是跨租户纯标量）
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@unique([tenantId, number])
  @@unique([subscriptionId, periodStart])
  @@index([tenantId, status])
  @@map("invoices")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  tenantId  String
  provider  String
  channel   String
  /** 支付方式类型：CARD / WECHAT / ALIPAY */
  type      String
  /**
   * 渠道侧的授权凭证。
   * ⚠️ **真实渠道必须加密存**（可解密的密文，不能是哈希 ——
   *  自动续费要拿它去扣款，不是用来比对的）。
   *  本阶段的假网关给的是明文假 token。
   */
  token     String
  isDefault Boolean  @default(false)
  /** 授权过期时间。null = 不过期 */
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([tenantId])
  @@map("payment_methods")
}
