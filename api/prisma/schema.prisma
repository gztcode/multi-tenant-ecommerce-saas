generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
  CUSTOMER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  DRAFT
  LIVE
  PAUSED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  subdomain String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users  User[]
  stores Store[]

  // ---------- 商品中心（Task 2）反向关系 ----------
  // Prisma 要求双向关系都声明，否则 schema 校验直接失败。
  categories         Category[]
  products           Product[]
  productSpecs       ProductSpec[]
  productSpecValues  ProductSpecValue[]
  skus               Sku[]
  skuSpecValues      SkuSpecValue[]
  medias             Media[]
  productMedias      ProductMedia[]
  inventoryMovements InventoryMovement[]

  // ---------- 交易链路（计划 3）反向关系 ----------
  carts Cart[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String?
  email        String
  phone        String?
  passwordHash String
  displayName  String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // ---------- 交易链路（计划 3）反向关系 ----------
  // Cart 声明了 customer User? @relation，Prisma 要求双向都声明。
  carts Cart[]

  // 邮箱唯一性分三层，全部由原生 SQL 的**部分唯一索引**保证，Prisma schema
  // 表达不了条件唯一约束，因此这里刻意不再声明任何 @@unique：
  //   PLATFORM_ADMIN → users_platform_admin_email_key（全局，tenantId IS NULL）
  //   MERCHANT_OWNER → users_merchant_owner_email_key（全局，见 add_merchant_owner_email_unique）
  //   CUSTOMER / MERCHANT_STAFF → users_customer_email_ci_key（租户内，见 narrow_customer_email_ci_unique）
  //
  // ⚠️ 曾经的 @@unique([tenantId, email]) 已删除（见 drop_user_tenant_email_unique）。
  // 它不含角色，会把「店主在自己开的店里当消费者下单」这种正常用法也一起挡掉，
  // 抛出无法解释给用户的 P2002。留下它等于让部分索引形同虚设——
  // 它更严格，冲突永远发生在部分索引之前。
  //
  // db push 等同步路径下会缺失这些部分索引，届时邮箱唯一性会暂时失效；
  // 正式环境一律用 migrate deploy。
  //
  // 配合应用层统一小写化的 email 精确查询
  @@index([email])
  @@map("users")
}

enum RefreshTokenRevokedReason {
  ROTATED
  LOGOUT
  REPLAY
}

model RefreshToken {
  id            String                     @id @default(uuid())
  userId        String
  // ROTATED：刷新时轮换掉旧令牌
  // LOGOUT：用户主动登出
  // REPLAY：疑似泄露，令牌族整体作废
  // 重放检测只对 ROTATED 触发——登出后的令牌被再次使用不牵连其它设备。
  revokedReason RefreshTokenRevokedReason?
  tokenHash     String                     @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  // ⚠️ 阶段 5c：宽限期记录。
  //
  // rotatedToToken 存的是本枚令牌轮换出的**新令牌的密文**（AES-256-GCM），
  // 不是明文 —— 沿用 token.util.ts 里「不存明文」的原则
  // （这张表经常被备份与只读分析）。
  // graceExpiresAt 是宽限截止时刻，轮换时一次定死，不因重放而延长。
  rotatedToToken String?
  graceExpiresAt DateTime?
  createdAt     DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Store {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  slug          String
  status        StoreStatus @default(DRAFT)
  themeTokens   Json        @default("{}")
  paymentConfig Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 复合唯一索引的最左前缀已能服务「按 tenantId 查该租户的店铺」，
  // 不需要再单独建 @@index([tenantId])
  @@unique([tenantId, slug])
  @@map("stores")
}

// ---------- 商品中心 ----------

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  sort      Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  // ⚠️ 唯一索引刻意**不在 schema 里声明**：软删除后 slug 仍占用唯一性，
  // 而普通的 @@unique 做不到「仅对未删除记录生效」——带 deletedAt 的复合唯一
  // 也无效，因为 PostgreSQL 的 NULL 不参与唯一性判定。
  // 改由迁移手写部分唯一索引（见 migration.sql）。
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  tenantId    String
  categoryId  String?
  name        String
  slug        String
  subtitle    String?
  description String?
  status      ProductStatus @default(DRAFT)
  attributes  Json          @default("{}")
  minPrice    Int           @default(0)
  version     Int           @default(1)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specs    ProductSpec[]
  skus     Sku[]
  media    ProductMedia[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model ProductSpec {
  id        String    @id @default(uuid())
  tenantId  String
  productId String
  name      String
  sort      Int       @default(0)
  deletedAt DateTime?

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductSpecValue[]
  // Cascade：删租户（销户 / 违规清退）必须连带清掉全部业务数据，
  // 若这里默认成 Restrict，删租户会被自己的关联表挡住而失败。
  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ⚠️ 唯一索引刻意**不在 schema 里声明**，由迁移手写部分唯一索引（见迁移文件）。
  // 软删除后同名规格会占用普通 @@unique：商家把「颜色」规格删掉再加一个同名
  // 的，数据库会直接拒绝。
  @@index([tenantId, productId])
  @@map("product_specs")
}

model ProductSpecValue {
  id        String    @id @default(uuid())
  tenantId  String
  specId    String
  value     String
  mediaId   String?
  sort      Int       @default(0)
  deletedAt DateTime?

  spec          ProductSpec    @relation(fields: [specId], references: [id], onDelete: Cascade)
  media         Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skuSpecValues SkuSpecValue[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引（软删除后同名值不占用唯一性）。
  @@index([tenantId, specId])
  @@map("product_spec_values")
}

enum SkuStatus {
  ACTIVE
  INACTIVE
}

model Sku {
  id           String    @id @default(uuid())
  tenantId     String
  productId    String
  code         String?
  price        Int
  comparePrice Int?
  stock        Int       @default(0)
  // 库存的乐观锁版本号。库存调整是「读库存 → 算 delta → 写」，
  // 并发时两个请求会各自读到同一个旧值、后写的覆盖先写的（丢失更新）——
  // 症状是入库两笔却只进了一笔。把版本号放进 updateMany 的 where，
  // 由数据库在写入那一刻判定，受影响行数为 0 即说明期间有人改过。
  // 与 Product.version 是同一个模式。
  stockVersion Int       @default(0)
  status       SkuStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  specValues SkuSpecValue[]
  movements  InventoryMovement[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ---------- 交易链路（计划 3）反向关系 ----------
  // CartItem 声明了 sku Sku @relation，Prisma 要求双向都声明。
  cartItems CartItem[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, productId])
  @@map("skus")
}

model SkuSpecValue {
  id       String @id @default(uuid())
  tenantId String
  skuId    String
  valueId  String

  sku    Sku              @relation(fields: [skuId], references: [id], onDelete: Cascade)
  value  ProductSpecValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([skuId, valueId])
  @@index([tenantId, skuId])
  @@map("sku_spec_values")
}

enum MediaStatus {
  PENDING
  READY
  ORPHANED
}

model Media {
  id         String      @id @default(uuid())
  tenantId   String
  key        String
  url        String
  mime       String
  size       Int
  width      Int?
  height     Int?
  status     MediaStatus @default(PENDING)
  uploadedBy String
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products   ProductMedia[]
  specValues ProductSpecValue[]

  // ⚠️ 唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, status])
  @@map("media")
}

model ProductMedia {
  id        String @id @default(uuid())
  tenantId  String
  productId String
  mediaId   String
  sort      Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([tenantId, productId])
  @@map("product_medias")
}

enum InventoryMovementType {
  INITIAL
  ADJUST_IN
  ADJUST_OUT
  CHECK
  RESERVE
  RELEASE
  DEDUCT
}

model InventoryMovement {
  id          String                @id @default(uuid())
  tenantId    String
  skuId       String
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String?
  // 谁做了这次库存变动。
  //
  // ⚠️ 可空：阶段 2 的库存调整是商家手动操作，填店主 id；
  // 阶段 3 的预占（RESERVE）/释放（RELEASE）是**系统行为**，没有人工操作人——
  // 游客下单时连 orders.customerId 都是空的，填不出一个消费者 id。
  // 填 'system' 这类假值会让「谁动了库存」失真，所以宁可留空。
  operatorId  String?
  createdAt   DateTime              @default(now())
  // 这次库存变动属于哪个订单（订单的 uuid，不是 orderNo）。
  //
  // ⚠️ **流水与订单之间原本只有自由文本的 reason**（形如「订单 <uuid> 预占」），
  // 没有任何数据层关联——要查「某个订单预占了多少」只能去解析 reason 文本。
  // 于是「这些条目确实被预占过」这件事无法在数据层验证：
  // 对一个从未预占过的 SKU 调释放，库存会凭空 +5，而流水与库存的净变化
  // **是自洽的**，对账时看不出问题。
  //
  // 有了这个字段就能按 orderId 汇总出「尚未被冲抵的预占量」，
  // 释放与扣减都拿它当上限校验——把「释放的正确性」从
  // 「调用方记得先判赢家」变成数据层保证。
  //
  // ⚠️ 可空：阶段 2 的 INITIAL / ADJUST_IN / ADJUST_OUT 流水与订单无关。
  orderId String?

  // Restrict 而非 Cascade：流水是审计凭证，物理删除有流水的 SKU 必须被数据库拒绝
  sku    Sku    @relation(fields: [skuId], references: [id], onDelete: Restrict)
  // 对租户同样保持 Restrict（默认值）：流水是合规凭证，销户时不允许被级联抹掉。
  // 代价是「有流水的租户」无法直接物理删除——这是刻意的，
  // 销户流程应走软删（Tenant 自身状态）而非 DELETE。
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, skuId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ---------- 交易链路（计划 3） ----------

model Cart {
  id         String   @id @default(uuid())
  tenantId   String
  // 登录用户的购物车：customerId 有值、guestToken 为空
  customerId String?
  // 游客的购物车：guestToken 有值、customerId 为空
  guestToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer User?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  // ⚠️ 唯一索引刻意**不在 schema 里声明**：一个消费者在同一店铺只有一个购物车
  // 是「登录合并」的前提，靠部分唯一索引保证（Prisma 表达不了条件唯一约束）。
  // 见 add_transaction_tables 迁移里手写的两个部分唯一索引。
  @@index([tenantId, customerId])
  @@index([tenantId, guestToken])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  tenantId  String
  cartId    String
  skuId     String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([cartId, skuId])
  @@index([tenantId, cartId])
  @@map("cart_items")
}

model Address {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  receiver   String
  phone      String
  province   String
  city       String
  district   String
  detail     String
  isDefault  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 加上外键的话「跨租户挂载」会被数据库悄悄放行（外键只引用 id 不带 tenantId），
  // 由 service 层显式校验归属（设计 §3.3）。
  //
  // ⚠️ 默认地址唯一索引由迁移手写部分唯一索引，不在 schema 里声明。
  @@index([tenantId, customerId])
  @@map("addresses")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
  CLOSED
}

/**
 * 抽佣流水的类型。
 *
 * ⚠️ **冲回不是负的数字字段，是一行独立的流水** ——
 * 这样「冲回了哪一笔」在表里查得到，且流水是 append-only 的审计凭证。
 */
enum CommissionEntryType {
  /** 抽佣（支付成功时记） */
  COMMISSION
  /** 退款冲回（退款成功时记） */
  REVERSAL
}

/// 商家应收货款的流水类型（阶段 5h-1）。
///
/// ⚠️ **与 `CommissionEntryType` 完全同款**：SALE 为正（货款入账）、
/// SALE_REVERSAL 为负（货款冲回 = 全额退款）。单列求和即净额。
enum ReceiptType {
  /// 货款入账（正数）：订单支付成功
  SALE
  /// 货款冲回（负数）：订单全额退款
  SALE_REVERSAL
}

/// 出款单的状态机（阶段 5h-1）。
///
/// ⚠️ **PAID / FAILED 在 5h-1 不可达** —— 本阶段不打钱，
/// 渠道那一半在 5h-2（5g 的 D5 同样的「预留比将来补省事」：加枚举值要改 schema + 迁移）。
enum PayoutStatus {
  /// 待审批：商家已申请，金额是**预估**
  REQUESTED
  /// 已审批：金额已锁定
  APPROVED
  /// 已拒绝：商家可重新申请同一周期
  REJECTED
  /// 已撤回：商家主动撤销（仅 REQUESTED 可撤）
  CANCELLED
  /// 已出款（5h-1 不可达，5h-2 用）
  PAID
  /// 出款失败（5h-1 不可达，5h-2 用）
  FAILED
}

model Order {
  id         String      @id @default(uuid())
  tenantId   String
  orderNo    String      @unique
  customerId String?
  status     OrderStatus @default(PENDING_PAYMENT)

  totalAmount Int
  itemCount   Int

  // 收货信息快照（来自下单时选中的地址，之后地址簿改了也不影响订单）
  receiverName  String
  receiverPhone String
  province      String
  city          String
  district      String
  detail        String

  remark String?

  // 幂等键。同一个键重复下单返回同一个订单，而不是新建一个。
  // 部分唯一索引：不同租户可以用同一个键（虽然不该，但不该因此报错）。
  idempotencyKey String?

  payChannel   String?
  payExpiresAt DateTime?
  paidAt       DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  closedAt     DateTime?
  trackingNo   String?

  // ---------- 阶段 5a：优惠快照 ----------
  //
  // ⚠️ **全部是快照**：券的名称、码、活动将来改了或删了，
  // 历史订单的金额与凭证都不受影响（设计文档 §7.2 M12）。
  //
  // ⚠️ `originalAmount` 是「优惠前的原价小计」，
  // `totalAmount` 是「优惠后的实付」——
  // **totalAmount 保持它现有的语义**（阶段 3 的支付金额核对读的是它，
  // 见 payment.service.ts 的 checkWebhookEvent：`event.amount !== order.totalAmount`），
  // 所以支付金额自动就是实付额，不需要改支付链路。
  originalAmount Int @default(0)
  // 满减活动减免
  promotionDiscountAmount Int @default(0)
  promotionId String?
  // 优惠券减免
  couponDiscountAmount Int @default(0)
  couponId String?
  couponCode String?
  couponName String?

  // ---------- 阶段 5b：抽佣与退款快照 ----------
  //
  // ⚠️ 同样是快照：抽佣费率将来随套餐调整，历史订单的抽佣额不能跟着变。
  /** 抽佣费率快照（基点）。下单时从套餐读，写死在订单上 */
  commissionRate Int @default(0)
  /** 抽佣额快照（整数分）。下单时按实付算出 */
  commissionAmount Int @default(0)
  /**
   * 退款时间。
   *
   * ⚠️ **阶段 3 的退款没有记时间** —— 报表的「退款冲回」要按**退款发生的
   * 期间**归期（不是按订单支付期间），所以这个字段是必需的。
   * 退款路径（`api/src/modules/payment/payment.service.ts` 的退款方法）
   * 要顺手写上 —— 但**那是下一个 Task 的事**。
   */
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 「跨租户挂载」由 service 层显式校验，而不是靠外键悄悄放行。
  items    OrderItem[]
  payments Payment[]
  // 阶段 5e：抽佣流水（一笔抽佣一行、一笔冲回一行）
  commissionEntries CommissionEntry[]
  // 阶段 5h-1：货款流水（商家应收，一笔货款一行、一笔冲回一行）
  receipts MerchantReceipt[]

  // ⚠️ 幂等键的部分唯一索引由迁移手写，不在 schema 里声明。
  @@index([tenantId, customerId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

/**
 * 抽佣流水（阶段 5e）。
 *
 * ⚠️ **一笔抽佣一行、一笔冲回一行**，金额带符号：
 * COMMISSION 的 amount > 0，REVERSAL 的 amount < 0。
 * 单列求和即净额。
 *
 * ⚠️ **为什么要有这张表**：5b 的决策是「抽佣不建独立表，存成订单上的两个快照字段」，
 * 遗留写的是「报表 SQL 要跨订单聚合；将来做结算单时再抽一层」。
 * 本阶段把那层抽出来了 —— 不是因为分叉点变多了，而是
 * **「按商家 × 区间出结算单」需要「这一笔属于哪个商家的哪一次成交」**，
 * 从订单聚合算不出来。
 */
model CommissionEntry {
  id       String @id @default(uuid())
  tenantId String
  orderId  String
  /** 订单号快照（对外凭证） */
  orderNo  String
  type     CommissionEntryType
  /**
   * 金额（整数分，**带符号**）。
   * COMMISSION > 0（抽佣）；REVERSAL < 0（冲回）。
   */
  amount Int
  /** 抽佣费率快照（基点）。套餐费率会变 → 必须快照 */
  rateBps Int
  /** 计佣基数快照（= 实付 = `Order.totalAmount`） */
  baseAmount Int
  /**
   * 业务发生时间。
   * COMMISSION = 支付时间；REVERSAL = 退款时间。
   * ⚠️ **与平台收入报表的归期口径逐字一致** ——
   * 抽佣按 `paidAt`、冲回按 `refundedAt`。
   */
  occurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /**
   * ⚠️ **外键 Restrict**：流水是审计凭证，
   * 有流水的订单不允许被物理删除（与 `InventoryMovement` 同款理由）。
   */
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /** 阶段 5g：被哪些结算单纳入了 */
  settlementEntries SettlementStatementEntry[]

  // ⚠️ 一单一抽佣、一单一冲回 → 幂等的兜底
  @@unique([orderId, type])
  @@index([tenantId, occurredAt])
  @@index([occurredAt])
  @@map("commission_entries")
}

model OrderItem {
  id          String @id @default(uuid())
  tenantId    String
  orderId     String
  skuId       String
  productId   String
  // 下单时的商品名与规格快照。商家后来改了名、改了价，订单里必须是当时的
  productName String
  skuSnapshot Json
  quantity    Int
  unitPrice   Int
  subtotal    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  // 这笔支付单是订单支付还是订阅支付
  // ⚠️ `kind` 与 `orderId`/`invoiceId` 的一致性**目前没有 DB 层约束**
  // （`payments` 表上没有 CHECK），由应用层保证。
  kind          PaymentKind   @default(ORDER)
  /** 订单支付时填；订阅支付为 null */
  orderId       String?
  /** 订阅支付时填；订单支付为 null */
  invoiceId     String?
  channel       String
  // ⚠️ provider 与 channel **不是一回事**：channel 是「微信 / 支付宝 / 假网关」
  // 这类渠道名，provider 是「渠道背后的服务提供方」（微信支付 vs 微信服务商、
  // 支付宝 vs 支付宝服务商）。幂等去重要按 provider 走——同一笔交易在服务商
  // 模式下会同时收到「服务商」与「直连」两个渠道的通知。
  provider      String
  status        PaymentStatus @default(PENDING)
  providerTxnId String?
  amount        Int
  rawResponse   Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // ⚠️ 下面三条唯一索引**在 schema 里都不声明**，索引名只存在于迁移 SQL 中：
  // Prisma 的 @@unique 表达不了「NULL 不参与唯一判定」这个语义。
  //
  // 1. (provider, providerTxnId) → 迁移里的 `payments_provider_txn_uniq`。
  //    缺了它，同一笔渠道交易会落成两条支付单（设计 §3.6）。
  //
  // 2. (orderId, channel) → 迁移里的 `payments_order_channel_uniq`。
  //
  // 3. (invoiceId, channel) → 迁移里的 `payments_invoice_channel_uniq`。
  //
  // 第 2、3 条是**部分唯一索引**（WHERE ... IS NOT NULL）——
  // orderId / invoiceId 变可空后，PostgreSQL 的 NULL 不参与唯一判定，
  // 普通唯一索引会直接失效。
  //
  // ⚠️ 因此**不要**在这里补 `@@unique([orderId, channel])` 或
  // `@@unique([invoiceId, channel])`：写了也不生效
  // （schema 里补不出部分唯一索引），只会让人误以为约束已经在数据库层。
  @@index([tenantId, status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  eventId       String
  providerTxnId String?
  payload       Json
  /**
   * 这笔是订单支付还是订阅支付（阶段 5f 加）。
   *
   * ⚠️ **由 webhook 端点写入**（端点自己知道是哪个端点），不是渠道适配器猜的、
   *    也不是从请求体里取的 → **不可被渠道伪造**。
   *
   * ⚠️ **为什么需要它**：补偿扫描要重新入队「上次没处理完」的 webhook 事件，
   *    而消费端靠 `kind` 决定反查订单还是反查账单。事件行原来没有这一列，
   *    补偿扫描就分不清该反查哪张业务单。
   *
   * ⚠️ **不加 `tenantId`** —— 阶段 3 的 R14：租户从业务单反查，不采信事件里的租户。
   */
  kind          PaymentKind @default(ORDER)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  // ⚠️ 这张表**不带 tenantId**，因此不在 TENANT_SCOPED_MODELS 白名单里
  // （它不是租户的数据，是渠道事件的数据）。租户从订单反查，不从事件里取。
  //
  // ⚠️ 唯一索引是「验签」之后的第二道防线，顺序不能反：
  // 先验签再落库，否则攻击者能抢先占住 (provider, eventId)，
  // 让真实回调被当成重复事件忽略——钱付了订单永不流转（设计 §3.7）。
  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

// ---------- 阶段 5a：营销（优惠券与满减活动） ----------

enum CouponType {
  FIXED
  PERCENT
}

enum CouponScope {
  SHOP
  PLATFORM
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model Coupon {
  id          String   @id @default(uuid())
  tenantId    String
  // 平台券的 tenantId 指向平台租户；店铺券指向商家租户
  code        String
  name        String
  description String?
  // FIXED：满减券（本阶段唯一实现的类型）
  // PERCENT：折扣券（预留，本阶段不实现）
  type        CouponType @default(FIXED)
  // FIXED 时是面额（整数分）；PERCENT 时是折扣数（85 = 85 折）
  value       Int
  // 使用门槛（整数分）。0 = 无门槛
  minAmount  Int      @default(0)
  // 每用户限领张数；null = 不限
  perUserLimit Int?
  // 总发放上限；null = 不限
  totalLimit  Int?
  // 已领取总数（用于限总量的并发判定）
  claimedCount Int    @default(0)
  // 已发放的券里，当前被订单预占核销的数量
  reservedCount Int    @default(0)
  // 已被订单实际使用的数量
  usedCount   Int      @default(0)
  // 平台券对所有店铺生效；店铺券只在本店生效
  scope       CouponScope @default(SHOP)
  status      CouponStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  // 与 Order / Address 同款做法：外键只引用 id 不带 tenantId，
  // 「跨租户挂载」由 service 层显式校验，而不是靠外键悄悄放行。
  //
  // ⚠️ 唯一索引由迁移手写部分唯一索引（软删后 code 仍占用唯一性）。
  @@index([tenantId, status])
  @@map("coupons")
}

model CouponClaim {
  id        String   @id @default(uuid())
  tenantId  String
  couponId  String
  customerId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  //
  // ⚠️ 唯一索引 (couponId, customerId) 由迁移手写，
  // 不在 schema 里声明（见 migration.sql）。
  @@index([tenantId, customerId])
  @@map("coupon_claims")
}

enum CouponRedemptionStatus {
  RESERVED
  USED
  RELEASED
}

model CouponRedemption {
  id         String   @id @default(uuid())
  tenantId   String
  couponId   String
  customerId String
  orderId    String
  // RESERVED：订单已创建，额度被占住；订单取消/超时后释放
  // USED：订单已支付，额度真正消耗
  // RELEASED：额度已退回
  status     CouponRedemptionStatus @default(RESERVED)
  // 下单时的优惠额快照
  discountAmount Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量（与 Order 同款）。
  //
  // ⚠️ 唯一索引由迁移手写部分唯一索引（见 migration.sql）。
  @@index([tenantId, customerId])
  @@map("coupon_redemptions")
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

model Promotion {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  // 门槛（整数分）：订单商品原价小计 ≥ minAmount 才享受
  minAmount   Int      @default(0)
  // 减免金额（整数分）
  discountAmount Int
  status      PromotionStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⚠️ **刻意不声明 tenant 关系**，只有 tenantId 标量。
  @@index([tenantId, status])
  @@map("promotions")
}

// ---------- 阶段 5b：平台计费（套餐、订阅、账单、支付方式） ----------

enum PlanStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  FAILED
}

enum PaymentKind {
  ORDER
  SUBSCRIPTION
}

model Plan {
  id          String    @id @default(uuid())
  code        String
  name        String
  description String?
  /** 周期价格（整数分）。0 = 免费 */
  price       Int
  /** 订阅周期（天）。30 = 按月 */
  periodDays  Int       @default(30)
  /** 试用期（天）。0 = 无试用 */
  trialDays   Int       @default(0)
  /** 抽佣比例（基点，万分之一）。500 = 5% */
  commissionBps Int     @default(0)
  /** 商品数上限。null = 不限 */
  maxProducts Int?
  /** SKU 数上限。null = 不限 */
  maxSkus     Int?
  /** 店铺数上限。null = 不限。默认 1（绝大多数套餐只允许一个店铺） */
  maxStores   Int?     @default(1)
  /** 功能开关。缺省一律视为 false（保守） */
  features    Json      @default("{}")
  status      PlanStatus @default(ACTIVE)
  /** 展示顺序（小的在前） */
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ⚠️ **这张表刻意不带 tenantId**：套餐是「平台的数据」而不是「租户的数据」
  //（先例是阶段 3 的 PaymentWebhookEvent）。所以它不在 TENANT_SCOPED_MODELS 里。
  @@unique([code])
  @@index([status, sortOrder])
  @@map("plans")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String
  /** 套餐 id。⚠️ **纯标量，不声明 Prisma 关系** —— 套餐是平台的数据
   *  （不带 tenantId），订阅是租户的数据，
   *  跨域的外键会让「挂到一张不存在的套餐上」悄悄通过。
   *  与阶段 5a 的 `CouponClaim.couponId` 同款。 */
  planId       String
  /** 待生效的套餐（下个周期生效）。null = 不换 */
  pendingPlanId String?
  status       SubscriptionStatus @default(TRIAL)
  startedAt    DateTime           @default(now())
  /** 试用截止。null = 不是试用 */
  trialEndsAt  DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /** 到期后不自动续费 */
  cancelAtPeriodEnd  Boolean        @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  invoices Invoice[]

  @@unique([tenantId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String
  /** 套餐 id 快照（纯标量，同上） */
  planId         String
  /** 账单号（对外凭证，会出现在渠道页面与对账单里） */
  number         String
  /** 应付金额（整数分）。只从套餐价格读，不从请求体读 */
  amount         Int
  status         InvoiceStatus @default(OPEN)
  periodStart    DateTime
  periodEnd      DateTime
  /** 应付截止（一般是周期结束日） */
  dueAt          DateTime
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // ⚠️ 账单与订阅**同租户**，所以是真关系（不像 planId 那样是跨租户纯标量）
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@unique([tenantId, number])
  @@unique([subscriptionId, periodStart])
  @@index([tenantId, status])
  @@map("invoices")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  tenantId  String
  provider  String
  channel   String
  /** 支付方式类型：CARD / WECHAT / ALIPAY */
  type      String
  /**
   * 渠道侧的授权凭证。
   * ⚠️ **真实渠道必须加密存**（可解密的密文，不能是哈希 ——
   *  自动续费要拿它去扣款，不是用来比对的）。
   *  本阶段的假网关给的是明文假 token。
   */
  token     String
  isDefault Boolean  @default(false)
  /** 授权过期时间。null = 不过期 */
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([tenantId])
  @@map("payment_methods")
}

// ---------- 阶段 5g：结算单 ----------

/**
 * 结算单的状态。
 *
 * ⚠️ **`PAID` 本阶段不可达**：抽佣出款不做（5b 遗留 1 / 5e 的 L19）。
 *    枚举值先留着 —— **加枚举值要改 schema + 迁移**，出款阶段必然要用，
 *    预留比将来补省事。
 */
enum SettlementStatus {
  /** 草稿：可重算、可取消确认 */
  DRAFT
  /** 已确认：金额与明细冻结 */
  CONFIRMED
  /** 已出款（阶段 5g 不做，出款阶段用） */
  PAID
}

/**
 * 结算单（平台开给商家的应收单据，阶段 5g）。
 *
 * ⚠️ **一张单 = 一个商家 × 一个自然月**（UTC，左闭右开）。
 *
 * ⚠️ **金额只从流水算**（`commission_entries`），**不从订单重新聚合** ——
 *    报表那套口径抄一遍必然漂。三个金额是**生成时刻的快照**，
 *    写死在这张单上；确认之后不再变。
 */
model SettlementStatement {
  id       String @id @default(uuid())
  tenantId String
  /** 结算单号（对外凭证，服务端生成，客户端不能指定） */
  statementNo String           @unique
  /** 周期起点（含）。该月 1 日 00:00:00.000Z */
  periodStart DateTime
  /** 周期终点（不含）。次月 1 日 00:00:00.000Z */
  periodEnd   DateTime
  /**
   * 抽佣毛额（整数分）：Σ COMMISSION.amount。
   *
   * ⚠️ **非负性由服务端聚合保证**，数据库层面**没有 CHECK 约束兜底**
   * （`pg_constraint` 里这张表的 CHECK 约束数为 0）——直写负数不会被数据库拦下。
   */
  grossAmount Int
  /**
   * 退款冲回（整数分）：Σ REVERSAL.amount。
   *
   * ⚠️ **非正性由服务端聚合保证**，数据库层面**没有 CHECK 约束兜底**。
   *
   * ⚠️ **与平台收入报表的 `reversal` 符号相反** ——
   *    报表那边是正数（`netRevenue = commissionRevenue − reversal`），
   *    结算单这边是负数（`netAmount = grossAmount + reversalAmount`）。
   */
  reversalAmount Int
  /** 净额 = grossAmount + reversalAmount。**可以是负数** */
  netAmount Int
  /** 纳入的流水笔数 */
  entryCount Int @default(0)
  status     SettlementStatus @default(DRAFT)
  /** 确认时间。null = 未确认 */
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entries SettlementStatementEntry[]
  // 阶段 5h-1：引用本结算单的出款单（零额抽佣的商家该期没有结算单 → 可空）
  payouts Payout[]

  // ⚠️ **同一商家同一周期只能有一张单**：重复生成走「先查后插」的幂等路径。
  @@unique([tenantId, periodStart])
  // 列表按周期倒序翻页
  @@index([periodStart])
  // 按状态筛选（「有多少张草稿待确认」）
  @@index([status])
  @@map("settlement_statements")
}

/**
 * 结算单纳入了哪些抽佣流水。
 *
 * ⚠️ **`entryId` 是全局唯一**（不是 `(statementId, entryId)` 复合唯一）：
 *   后者只能保证「同一张单里不重复」，前者才能保证
 *   **「一笔流水只能被一期结算」**。复合唯一是后者的弱化版，
 *   会放过「同一笔流水被两张单各结一次」。
 *
 * ⚠️ **本表没有 `tenantId`，DB 层不校验两端的租户一致性** —— 跨租户挂载在数据库
 *   层面是允许的（实测把 B 租户的流水挂到 A 租户的结算单上能插进去），
 *   **一致性由 service 层保证**。将来做商家侧接口时，明细查询必须先校验
 *   `statementId` 属于当前租户。
 */
model SettlementStatementEntry {
  id          String   @id @default(uuid())
  statementId String
  /** 被纳入的抽佣流水 id（`commission_entries.id`） */
  entryId     String   @unique
  createdAt   DateTime @default(now())

  statement SettlementStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  // ⚠️ **外键 Restrict**：流水是审计凭证，被结算单纳入后不允许被物理删除
  entry     CommissionEntry       @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@map("settlement_statement_entries")
}

// ---------- 阶段 5h-1：出款（把货款结算给商家） ----------

/// 商家应收货款流水（阶段 5h-1）。
///
/// ⚠️ **与 `CommissionEntry` 同款**，只是金额基数不同：
/// 抽佣流水记的是 `order.commissionAmount`（平台抽的），
/// 货款流水记的是 `order.totalAmount`（商家该收的实付）。
///
/// ⚠️ **索引比它少一条**：`CommissionEntry` 上还有一条 `@@index([occurredAt])`，
/// 是为平台侧的**跨租户**抽佣台账设的（那条查询没有 `tenantId` 条件，
/// 走不了复合索引的前导列）。5h-1 没有跨租户货款台账这个场景 → 不加那条。
///
/// ⚠️ **写入点与抽佣流水在同一个事务里**（`payment.service.ts`）→
/// 不可能出现「有货款、无抽佣」的时序差。唯一的口径例外是
/// **零额抽佣**（费率 0 的订单有货款、无抽佣流水）。
model MerchantReceipt {
  id       String @id @default(uuid())
  tenantId String
  orderId  String
  /// 订单号快照（商家核对时要看）
  orderNo String
  type     ReceiptType
  /// 带符号整数分：SALE 为正、SALE_REVERSAL 为负
  amount Int
  /// 归期：支付取 `paidAt`、退款取 `refundedAt`（与抽佣流水逐字一致）
  occurredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// 阶段 5h-1：被哪张出款单出过一次（一笔货款只能出款一次 → `PayoutEntry.entryId` 全局唯一）
  payoutEntries PayoutEntry[]

  @@unique([orderId, type])
  @@index([tenantId, occurredAt])
  @@map("merchant_receipts")
}

/// 商家收款账户（阶段 5h-1）。
///
/// ⚠️ **一商家一账户**（`tenantId` 唯一）。
///
/// ⚠️ **`accountNo` 是明文存的** —— 本项目没有通用字段加密设施
/// （只在 auth 模块有 JWT 相关的）。**接真实支付渠道前必须改成加密存储**
/// （与 5b 对 `payment_methods` 的同一处理：设计写明，实现留到那一阶段）。
/// 界面只展示脱敏（尾号 4 位）。
model MerchantPayoutAccount {
  id       String @id @default(uuid())
  tenantId String @unique
  /// 开户人姓名
  accountName String
  /// 开户行
  bankName String
  /// 银行账号（⚠️ 明文存，见上）
  accountNo String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("merchant_payout_accounts")
}

/// 出款单（阶段 5h-1）。
///
/// ⚠️ **金额三件套站在「商家应收」角度**：
/// `commissionAmount` 是**正数**（平台抽了多少，与结算单的 `netAmount` 同号），
/// `netAmount = receiptAmount − commissionAmount` 是应结给商家的钱。
/// ⚠️ **别把结算单的 `reversalAmount`（负数）那套符号搬过来** —— 这一类
/// 已坑过两次（5g 的结算单 vs 平台收入报表）。
model Payout {
  id       String @id @default(uuid())
  tenantId String
  /// 出款单号（对外凭证，服务端生成；生成规则与撞号重试照抄 5g 的 `generateStatementNo`）
  payoutNo String @unique
  /// 周期起点（含）。该月 1 日 00:00:00.000Z
  periodStart DateTime
  /// 周期终点（不含）。次月 1 日 00:00:00.000Z
  periodEnd DateTime
  /// 引用的结算单。⚠️ **可空**：零额抽佣的商家该期没有结算单
  statementId String?
  /// 货款净额（正数）：该期 `merchant_receipts` 的金额之和
  receiptAmount Int
  /// 佣金净额（**正数** = 平台抽了多少）：结算单的 `netAmount`
  commissionAmount Int
  /// 应结给商家的金额 = `receiptAmount − commissionAmount`
  netAmount Int
  /// 纳入的货款流水笔数
  entryCount Int
  status PayoutStatus @default(REQUESTED)
  /// 申请时的**预估**金额（与 `netAmount` 可能不同 —— 审批时会重算）
  requestedAmount Int
  /// 申请人的用户 ID
  requestedBy String
  /// 审批人的用户 ID
  approvedBy String?
  /// 拒绝原因（拒绝时必填）
  rejectedReason String?
  requestedAt DateTime @default(now())
  approvedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statement SettlementStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)
  entries PayoutEntry[]

  @@index([status])
  @@map("payouts")
}

/// 出款单明细关联（阶段 5h-1）。
///
/// ⚠️ **刻意不带 `tenantId`** → 不登记进 `TENANT_SCOPED_MODELS`
/// （与 5g 的 `settlement_statement_entries` 同款）：
/// 租户作用域扩展对它不附加任何过滤 → **service 层必须自己校验归属**。
model PayoutEntry {
  id       String @id @default(uuid())
  payoutId String
  /// 指向 `merchant_receipts.id` —— 一笔货款只能被出款一次
  entryId String @unique
  createdAt DateTime @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  entry  MerchantReceipt @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("payout_entries")
}
