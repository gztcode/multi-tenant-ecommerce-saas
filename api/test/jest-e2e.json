{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/setup-e2e.ts",
  "setupFilesAfterEnv": ["<rootDir>/test/setup.ts"],
  "coverageDirectory": "coverage-e2e",
  "coverageThreshold": {
    "global": {
      "statements": 79,
      "branches": 60,
      "functions": 85,
      "lines": 79
    }
  }
}
