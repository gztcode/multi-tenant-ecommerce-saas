# PostgreSQL 配置源：docker-compose.yml 通过 ${VAR:-默认值} 引用这里的变量。
# 复制为 .env 后可覆盖默认值；不复制也能起（compose 内置默认值与此处一致）。
# 用法：cp .env.example .env

# 宿主机绑定地址：默认只绑本机回环。
# 需要局域网访问时显式改成 0.0.0.0，并注意 MinIO 复用 root 凭据。
BIND_HOST=127.0.0.1

# 宿主机端口（本机 5432/6379 已被其他项目占用）
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=15432
REDIS_PORT=16380
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
API_PORT=3000
STOREFRONT_PORT=3001
MERCHANT_ADMIN_PORT=3002
PLATFORM_ADMIN_PORT=3003
NGINX_PORT=80

# 前端构建期变量（NEXT_PUBLIC_* 会被内联进产物）
NEXT_PUBLIC_TENANT_SUBDOMAIN=demo

# JWT 与 NextAuth 密钥
# ⚠️ 以下两个都是**示例值**：生产环境会被启动守卫拒绝，必须替换。
# ⚠️ 长度都必须 ≥ 32 字符：AUTH_SECRET 短于 32 字符时 api 与三端前端都会拒绝启动。
JWT_SECRET=change-me-in-production-at-least-32-chars-long
AUTH_SECRET=local-dev-only-auth-secret-at-least-32-chars

# MinIO
MINIO_ROOT_USER=ecommerce
MINIO_ROOT_PASSWORD=ecommerce-minio-secret
# 允许直传的来源，英文逗号分隔。镜像里没有 mc，只能靠这个环境变量配 CORS。
# ⚠️ 变量名必须是 MINIO_API_CORS_ALLOW_ORIGIN（写错会被 MinIO 静默忽略，白名单失效）。
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost
# 三个 endpoint 各管各的：
# - MINIO_ENDPOINT 会被签进 presigned URL，必须是浏览器能访问的宿主机地址
# - MINIO_INTERNAL_ENDPOINT 是后端自己 HEAD/删除对象用的容器内地址
# - MINIO_PUBLIC_URL 写进 media.url
MINIO_ENDPOINT=http://localhost:19000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_BUCKET=ecommerce-media
MINIO_REGION=us-east-1
MEDIA_MAX_SIZE=5242880
# 当前镜像 digest（cgr.dev/chainguard/minio:latest 只有 latest 一个 tag，
# 没有版本 tag 可钉，compose 已直接用 digest 引用）：
# sha256:ad134b2dd572ae0d989d6807c3e45516cc75a34883a8021db2ff04be5d1d496a
# 对应 MinIO 版本 RELEASE.2026-09-22T19-25-18Z

# Redis
# 队列密码。只用字母与数字：密码会拼进 redis:// URL，特殊字符需要额外转义。
REDIS_PASSWORD=ecommerceRedis163

# 渠道（留空 = 使用代码默认值）
# ⚠️ 非生产环境即使留空，渠道列表也会列出 fake / fake-payout；
#    但 FAKE_PAYMENT_ENABLED / FAKE_PAYOUT_ENABLED 默认关闭 ——
#    「列表可见」不等于「调用可用」，调用会被拒绝。
CHANNEL_MODE=
PAYMENT_ENABLED_CHANNELS=
PAYOUT_ENABLED_CHANNELS=
PAYOUT_PLATFORM_DEFAULT_CHANNEL=
FAKE_PAYMENT_ENABLED=
FAKE_PAYOUT_ENABLED=

# 出款账户与账单快照的字段加密密钥（≥ 32 字符）。
# ⚠️ 这里填的是 compose 内置默认值：本机开发**保持不变**，
#    否则既有出款单快照会解不开。真实部署必须换成随机密钥；
#    生产环境使用默认值会被启动守卫拒绝。
# ⚠️ 轮换会导致既有快照永久解不开。
PAYOUT_ACCOUNT_ENCRYPTION_KEY=local-dev-only-payout-encryption-key-at-least-32-chars

# ---- 生产部署（阶段 11，配合 docker-compose.prod.yml）----
# 店铺子域名的基准域（如 example.com → 店铺在 <tenant>.example.com）。
# 生产 override 用 :? 强制要求此变量，缺失时 compose 直接报错。
# BASE_DOMAIN=example.com
# 网关限流阈值（Nginx 层，按客户端 IP 计；单位分别为「每秒请求数」与
# 「突发队列长度」）。三档分别对应：
#   FRONT —— 三个前端的 location /（浏览器真实流量入口，页面 + BFF 中转）
#   API   —— 直连 api 的 /api/v1（脚本、第三方集成）
#   AUTH  —— api 的 /api/v1/auth/（登录/刷新等，从紧）
# ⚠️ 不配 = 脚本内置的保守默认值（front 20/100、api 20/40、auth 10/20）。
#    **这些默认值是保守占位，上线前必须按真实访问日志校准**，
#    方法与算例见 docs/deployment.md §9。配错（非数字 / 超长）会回落默认值
#    并在 nginx 日志里点名，不会让 nginx 起不来。
# RATE_LIMIT_FRONT_RATE=20
# RATE_LIMIT_FRONT_BURST=100
# RATE_LIMIT_API_RATE=20
# RATE_LIMIT_API_BURST=40
# RATE_LIMIT_AUTH_RATE=10
# RATE_LIMIT_AUTH_BURST=20
# statement_timeout（毫秒）。仅影响数据卷**首次初始化**的库；
# 已有库按 docs/deployment.md 手动 ALTER。置 0 禁用。
# STATEMENT_TIMEOUT_MS=8000
# 渠道告警 webhook（飞书/钉钉/自建值班群；不配则告警只落日志）
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=generic
