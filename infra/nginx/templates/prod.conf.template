# 生产环境 Nginx 配置模板（阶段 11：部署加固）。
#
# ## 生效方式
#
# 官方 nginx 镜像的 entrypoint 会把 /etc/nginx/templates/*.template 经
# envsubst 渲染到 /etc/nginx/conf.d/——且**只替换环境里存在的变量**，
# $tenant / $host 这类 nginx 运行时变量不受影响。
# 由 docker-compose.prod.yml 挂载本目录并注入 BASE_DOMAIN。
#
# ## 需要的环境变量（见 infra/.env.example 与 docs/DEPLOY.md）
#
# - BASE_DOMAIN：店铺子域名的基准域，如 `example.com`
#   （店铺在 `<tenant>.${BASE_DOMAIN}`，证书需覆盖 `*.${BASE_DOMAIN}`——
#    Let's Encrypt 用 DNS-01 challenge 签泛域名证书，见 DEPLOY.md §证书）
# - 证书路径固定挂载到 /etc/nginx/certs/{fullchain.pem,privkey.pem}
# - METRICS_ALLOW_CIDR：Prometheus 抓取端点（/api/v1/metrics）的可信网段，
#   逗号分隔的 CIDR（如 10.0.0.0/8,192.168.0.0/16）。**不配 = 一个都不放行**
#   （fail-closed，metrics 抓不到 → 监控瞎，只能从内网补配）。
#   由 25-metrics-allow.sh 展开成 allow 语句（envsubst 不认逗号列表）。
# - RATE_LIMIT_*：网关限流阈值（`RATE_LIMIT_{FRONT,API,AUTH}_{RATE,BURST}`，
#   单位分别是「每秒请求数」与「突发队列长度」）。**不是** envsubst 变量：
#   由 26-rate-limit.sh 在 envsubst 之后展开 `#@RATE_LIMIT_*@` 占位行，
#   因为 envsubst 不支持默认值、也不会校验值（非法值会直接让 nginx 起不来）。
#   不配 = 脚本内置的保守默认值；配错 = 回落默认值并在日志里点名。
#   默认值必须按真实访问日志校准，见 docs/DEPLOY.md §9。
#
# ## 与 platform.test.conf（本机开发）的差异
#
# - 443 TLS + 80 跳转（保留 /.well-known/acme-challenge/ 给续期）
# - HSTS（只有全站确定走 https 后才开启；max-age 渐进：先 300 秒观察）
# - 限流落在**真实流量那一跳**（三个前端的 location /），开发配置没有
# - 限流拒绝统一 429 + Retry-After，开发配置仍是历史遗留的 503
# - **未配 real_ip**：限流按「与本机建连的对端 IP」计。上 CDN/LB 后必须补
#   set_real_ip_from + real_ip_header，否则所有请求都算在 CDN 节点 IP 上，
#   一把限流就把全站打死 —— 这是上线 CDN 前的硬前提。

upstream api_backend {
    server api:3000;
}

upstream storefront_backend {
    server storefront:3000;
}

upstream merchant_admin_backend {
    server merchant-admin:3000;
}

upstream platform_admin_backend {
    server platform-admin:3000;
}

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

client_max_body_size 10m;
proxy_read_timeout 60s;

# ---- 网关限流（P2-3 / P3-2） ----
#
# ## 限流为什么挂在「前端 server 块的 location /」
#
# 浏览器**不直连 api**（api 没开 CORS）：页面、RSC 导航、写操作都先打到同源
# 的 Next.js 服务，再由 BFF / RSC 在**服务端**用 API_BASE_URL
# （容器内 http://api:3000/api/v1）调 api —— 那一跳**不过 nginx**。
# 所以真正承受公网流量的入口是三个前端 server 块的 `location /`。
# 历史配置只限了 `location /api/v1/`，那是「一条没人走的道」：真实流量
# （包括 BFF 的 /api/cart、/api/auth 等）全部落在 `location /` 上，零限流。
#
# ## 键为什么是 $binary_remote_addr
#
# 它取「与本机建 TCP 连接的对端 IP」，客户端改不了。
# `$http_x_forwarded_for` 是**客户端可写**的头，拿它当键 = 换个头就绕过限流，
# 等于没有限流。将来前面加 CDN/LB 时用 real_ip 模块校正地址来源
# （见文件头的差异说明），而不是改读客户端头。
#
# ## 阈值从哪来
#
# 下面这行是**占位行**，由 26-rate-limit.sh 在 envsubst 之后替换成三条
# limit_req_zone 语句（envsubst 只认 ${VAR}、不支持默认值，也不校验值）。
# 脚本没跑 / 环境变量非法 → 占位行保持注释 → 限流不生效但 nginx 照常启动
# （可用性优先于限流；渲染期就断言过它必须被展开，见 prod-conf.render.test.mjs）。
# 内置默认值是**保守占位**，上线前必须按真实访问日志校准（DEPLOY.md §9）。
#@RATE_LIMIT_ZONES@

# 限流拒绝统一 429（P3-2）。503 会被客户端当成「服务故障」而重试，
# 反而放大压力；429 的语义是「你太快了」，配合各限流 location 的
# Retry-After 响应头告诉调用方多久后再来。
limit_req_status 429;

# TLS 会话复用与协议基线（http 级指令）
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;

# ---- 80 端口：ACME 续期 + 全站跳转 ----

# 未知 Host 一律断连（不给扫描器任何回音）
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# 已知域名的 80：证书签发/续期走 webroot，其余 301 到 https
server {
    listen 80;
    server_name ${BASE_DOMAIN} *.${BASE_DOMAIN} api.${BASE_DOMAIN} merchant.${BASE_DOMAIN} admin.${BASE_DOMAIN};

    # ACME http-01 challenge（certbot webroot 指向该卷）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- 443：未知 Host 兜底 ----
# 与 80 端口 return 444 同理，不给 TLS 扫描器任何回音。
# 必须放在 443 所有 server 块最前（第一个 443 块即默认 server），
# 否则未知 Host 会落到店铺子域名正则块被代理转发。
# ssl_reject_handshake 在 TLS 层直接拒绝握手，无需证书即可通过 nginx -t。
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# ---- 443：店铺子域名 ----
# 通配符证书 *.${BASE_DOMAIN}（DNS-01 签发）；Host 反推租户子域名的
# 逻辑与开发环境一致：网关注入并覆盖 X-Tenant-Subdomain。
server {
    listen 443 ssl;
    http2 on;
    server_name ~^(?<tenant>[a-z0-9-]+)\.${BASE_DOMAIN}$;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # HSTS：先短 max-age 观察（300s），确认无 http 依赖后再加到 31536000
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ⚠️ **真实流量入口**：店铺页面、RSC 导航、BFF 中转（/api/cart、
    # /api/auth/[...nextauth] 等）全部落在这一个 location 上。
    # 所有店铺子域名共用一个 zone —— 同一个 IP 的预算跨店铺共享，
    # 这正是要的效果：换个子域名不该换来一份新配额。
    #
    # ⚠️ **本层一旦出现 add_header，就不再继承 server 级的安全头** ——
    #    下面四条安全头是为 Retry-After 付的代价，原样补回来。
    location / {
        #@RATE_LIMIT_FRONT@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://storefront_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ⚠️ **支付渠道回调必须豁免限流**：渠道把非 2xx 当投递失败会重投/告警，
    # 而回调高峰（大促集中支付）正好是限流最容易被触发的时候。
    # 它们的安全边界在 api 侧：验签通过才落库 + (provider, eventId) 唯一索引
    # 幂等（见 api/src/modules/payment/webhook.controller.ts），不靠 IP 限流。
    # 必须比 /api/v1/ 更长（前缀匹配取最长），否则会被上面的限流吃掉。
    location /api/v1/webhooks/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 直连 api 的脚本流量（绕过 BFF 直接打 /api/v1）：仍按 API 档限流。
    location /api/v1/ {
        #@RATE_LIMIT_API@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 店铺子域名上的 metrics 也要收口：上面的 location /api/v1/ 会把请求
    # 转发到 api，不单独限制的话换个 Host（<店铺>.example.com）就能绕过
    # 中心域名上的白名单。规则与 API 中心域名块一致。
    location /api/v1/metrics {
        #@METRICS_ALLOW_CIDR@
        deny all;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /_next/static/ {
        proxy_pass http://storefront_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}

# ---- 443：API 中心域名 ----
server {
    listen 443 ssl;
    http2 on;
    server_name api.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Prometheus 抓取端点：生产**默认对公网不可达**。
    #
    # 白名单网段由 METRICS_ALLOW_CIDR 决定（逗号分隔的 CIDR，如 10.0.0.0/8）。
    # 它不是模板变量：envsubst 只认 ${VAR}，而一条 allow 指令只吃**一个**
    # 地址/CIDR，逗号列表没法直接写进模板 —— 所以由 25-metrics-allow.sh 在
    # envsubst 渲染之后，把下面的占位符行替换成若干条 allow 语句。
    #
    # ⚠️ 变量为空 / 展开脚本没跑 → 占位符保持注释 → 该 location 只剩 deny all，
    #    抓取全部拒绝（fail-closed），nginx 仍能正常启动。
    location /api/v1/metrics {
        #@METRICS_ALLOW_CIDR@
        deny all;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ⚠️ **支付渠道回调必须豁免限流**（与店铺子域名块同理）：
    # 中心域名是渠道回调的规范地址（https://api.<BASE_DOMAIN>/api/v1/webhooks/…），
    # 大促集中支付正是限流最容易误伤的时段，而回调有验签 + 幂等兜底。
    location /api/v1/webhooks/ {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/v1/auth/ {
        #@RATE_LIMIT_AUTH@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 直连 API 的其余路径（脚本、第三方集成）：保留网关兜底限流。
    location / {
        #@RATE_LIMIT_API@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ---- 443：商家后台 ----
server {
    listen 443 ssl;
    http2 on;
    server_name merchant.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 浏览器真实流量入口（页面 + 商家端 BFF 中转），与店铺前台共用一个
    # front_general zone：一个 IP 的预算跨入口共享。
    location / {
        #@RATE_LIMIT_FRONT@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://merchant_admin_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ---- 443：平台超管后台 ----
server {
    listen 443 ssl;
    http2 on;
    server_name admin.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 浏览器真实流量入口（页面 + 平台端 BFF 中转），共用 front_general zone。
    location / {
        #@RATE_LIMIT_FRONT@
        add_header Retry-After 1 always;
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass http://platform_admin_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Tenant-Subdomain "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
